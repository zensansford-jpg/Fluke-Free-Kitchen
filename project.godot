; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fluke Free Kitchen"
config/description="ครัวปลอดพยาธิ — a short, friendly cooking game that teaches how to prevent liver flukes and bile duct cancer."
config/version="2.0.0"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://autoload/settings_manager.gd"
SaveData="*res://autoload/save_manager.gd"
Loc="*res://autoload/localization.gd"
Learning="*res://autoload/learning_log.gd"
Education="*res://autoload/education_manager.gd"
Game="*res://autoload/game_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
InputManager="*res://autoload/input_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; `disabled` means one UI unit is one screen pixel: the interface reflows and
; switches layout at breakpoints instead of being scaled down to a sliver on a
; phone. See docs/RESPONSIVE.md and tests/responsive_check.tscn.
window/stretch/mode="disabled"
window/size/resizable=true
; Sensor = the device decides, so the reflowable layout can actually be used in
; portrait or landscape. Only meaningful on handheld platforms.
window/handheld/orientation=6

[physics]

3d/default_gravity=30.0

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.42, 0.6, 0.75, 1)
textures/vram_compression/import_etc2_astc=true
