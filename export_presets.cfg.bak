[preset.0]

name="Windows Desktop"
platform="Windows Desktop"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="tests/*"
export_path="build/FlukeFreeKitchen.exe"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2
script_encryption_key=""

[preset.0.options]

custom_template/debug=""
custom_template/release=""
debug/export_console_script=1
binary_format/embed_pck=true
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
binary_format/architecture="x86_64"
codesign/enable=false
codesign/identity_type=0
codesign/identity=""
codesign/password=""
codesign/timestamp=true
codesign/timestamp_server_url=""
codesign/digest_algorithm=1
codesign/description=""
codesign/custom_options=PackedStringArray()
application/modify_resources=false
application/icon="res://icon.svg"
application/console_wrapper_icon=""
application/icon_interpolation=4
application/file_version="2.0.0"
application/product_version="2.0.0"
application/company_name="Fluke Free Kitchen"
application/product_name="Fluke Free Kitchen"
application/file_description="Fluke Free Kitchen (ครัวปลอดพยาธิ) — an educational cooking game about liver fluke and bile duct cancer prevention"
application/copyright=""
application/trademarks=""
ssh_remote_deploy/enabled=false
ssh_remote_deploy/host="user@host_ip"
ssh_remote_deploy/port="22"
ssh_remote_deploy/extra_args_ssh=""
ssh_remote_deploy/extra_args_scp=""
ssh_remote_deploy/run_script="Expand-Archive -LiteralPath '{temp_dir}\\{archive_name}' -DestinationPath '{temp_dir}\\{archive_name}_dir' -Force; Kill-Process -Name '{exe_name}' -Force -ErrorAction SilentlyContinue; Start-Process -FilePath '{temp_dir}\\{archive_name}_dir\\{exe_name}' -ArgumentList '{cmd_args}'"
ssh_remote_deploy/cleanup_script="Stop-Process -Name '{exe_name}' -Force -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force '{temp_dir}'"
ssh_remote_deploy/upload_files_script="Expand-Archive -LiteralPath '{temp_dir}\\{archive_name}' -DestinationPath '{temp_dir}\\{archive_name}_dir' -Force; Remove-Item -Path '{temp_dir}\\{archive_name}' -Force"
dotnet/include_scripts_content=false
dotnet/include_debug_symbols=true
dotnet/embed_build_outputs=false
